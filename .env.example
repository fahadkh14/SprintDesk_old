# ---- SprintDesk configuration ----
# Copy this file to .env and change the passwords before sharing the project.

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=sprintdesk
MYSQL_USER=sprintdesk
MYSQL_PASSWORD=change_me_app_password

# Backend
BACKEND_PORT=5761
DB_HOST=mysql
DB_PORT=3306
DB_POOL_SIZE=10
CORS_ORIGIN=*

# Published host ports
FRONTEND_HOST_PORT=8092
BACKEND_HOST_PORT=5761

# Container time zone
TZ=UTC
